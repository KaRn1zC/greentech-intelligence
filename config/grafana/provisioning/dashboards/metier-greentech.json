{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Ratio Green IT",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "greentech_green_it_ratio",
          "legendFormat": "Ratio Green IT"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "green", "value": 0.3 }
            ]
          }
        }
      }
    },
    {
      "title": "Articles classifies",
      "type": "piechart",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "greentech_prediction_distribution",
          "legendFormat": "{{label}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "pieType": "donut"
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "green_it" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "non_green_it" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "title": "Modele en production",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "greentech_model_info",
          "legendFormat": "{{nom}} ({{type}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Total articles classifies",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(greentech_prediction_distribution)",
          "legendFormat": "Articles analyses"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Articles classifies dans le temps (historique complet)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "description": "Historique complet des classifications, lu directement depuis PostgreSQL (source de verite persistante) : toujours rempli avec tout le passe et s'incremente a chaque nouvelle classification, quel que soit le range du dashboard.",
      "timeFrom": "1y",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(date_creation, '1d') AS \"time\", count(*) FILTER (WHERE est_green_it IS TRUE) AS \"Green IT\", count(*) FILTER (WHERE est_green_it IS FALSE) AS \"Non Green IT\" FROM articles WHERE $__timeFilter(date_creation) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Green IT" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Non Green IT" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "title": "Articles classifies dans le temps (live)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(greentech_articles_classified_total{label=\"green_it\"}[5m])",
          "legendFormat": "Green IT"
        },
        {
          "expr": "rate(greentech_articles_classified_total{label=\"non_green_it\"}[5m])",
          "legendFormat": "Non Green IT"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Green IT" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Non Green IT" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "title": "Score de confiance moyen par modele",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(greentech_inference_confidence_bucket[5m]))",
          "legendFormat": "Confiance mediane"
        },
        {
          "expr": "histogram_quantile(0.95, rate(greentech_inference_confidence_bucket[5m]))",
          "legendFormat": "Confiance p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "title": "Empreinte carbone cumulee (CodeCarbon)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "greentech_carbon_emissions_grams_total",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "decimals": 4,
          "custom": { "lineWidth": 2, "fillOpacity": 15, "drawStyle": "line" }
        }
      }
    },
    {
      "title": "Data Drift Score",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "greentech_data_drift_score",
          "legendFormat": "Drift score"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "title": "Temps moyen d'analyse IA",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(greentech_inference_duration_seconds_sum[5m]) / rate(greentech_inference_duration_seconds_count[5m])",
          "legendFormat": "Temps moyen inference"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      }
    },
    {
      "title": "Temps moyen resume IA",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(greentech_summary_duration_seconds_sum[5m]) / rate(greentech_summary_duration_seconds_count[5m])",
          "legendFormat": "Temps moyen resume"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "CO2eq total (analyses)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(greentech_carbon_emissions_grams_total)",
          "legendFormat": "Total CO2",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "title": "Energie totale (analyses)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(greentech_energy_consumed_kwh_total)",
          "legendFormat": "Energie cumulee",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 6,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Repartition CO2 par operation",
      "type": "piechart",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "greentech_carbon_emissions_grams_total",
          "legendFormat": "{{operation}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "pieType": "donut"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "decimals": 4
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["greentech", "metier", "green-it"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GreenTech - Metier Green IT",
  "uid": "greentech-metier",
  "version": 5
}
